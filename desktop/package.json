{
    "name": "infinite-canvas-desktop",
    "version": "0.10.0",
    "private": true,
    "description": "Infinite Canvas macOS desktop application",
    "main": "main.cjs",
    "scripts": {
        "dev": "concurrently -k \"npm --prefix ../web run dev\" \"wait-on http://localhost:3000 && electron .\"",
        "build:web": "npm --prefix ../web run build:desktop",
        "package": "npm run build:web && electron-forge package --arch=arm64",
        "make": "npm run build:web && electron-forge make --arch=arm64"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.8.3",
        "@electron-forge/maker-dmg": "^7.8.3",
        "@electron-forge/maker-zip": "^7.8.3",
        "concurrently": "^9.2.1",
        "electron": "^37.2.6",
        "wait-on": "^8.0.4"
    },
    "config": {
        "forge": "forge.config.cjs"
    }
}
